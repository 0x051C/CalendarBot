# --- Required ---------------------------------------------------------------
DISCORD_TOKEN=
DATABASE_URL=postgres://calendarbot:calendarbot@localhost:5432/calendarbot

# --- Cluster ----------------------------------------------------------------
NATS_URL=nats://localhost:4222
# NATS auth: user+password, a token, or an NKey/JWT .creds file (pick one)
# NATS_USER=calendarbot
# NATS_PASSWORD=
# NATS_TOKEN=
# NATS_CREDS=/path/to/calendarbot.creds
# CA bundle for NATS TLS (tls:// URLs also enable TLS)
# NATS_TLS_CA=/path/to/ca.pem
# Namespace for NATS buckets/subjects, so several deployments can share a NATS server
CLUSTER_NAME=calendarbot
# Total gateway shards across all instances, or "auto" for Discord's recommendation
SHARD_COUNT=auto
# How long a shard lease lives without renewal; failover takes about this long
LEASE_TTL_MS=15000
# Defaults to <hostname>-<random>
# INSTANCE_ID=

# --- Behaviour --------------------------------------------------------------
# Default minutes before an event to post its alert (per server: /alert lead-time)
DEFAULT_ALERT_LEAD_MINUTES=5
SCHEDULER_INTERVAL_MS=10000
ICAL_PATH=./ical
ICAL_EVENT_DURATION_SECONDS=1800
# Set to false on staging instances that share a token with production
REGISTER_COMMANDS=true

# --- Ops --------------------------------------------------------------------
HTTP_PORT=8080
# 0.0.0.0 for containers; 127.0.0.1 when running directly on a host
HTTP_HOST=0.0.0.0
LOG_LEVEL=info
MIGRATIONS_DIR=./drizzle
