# Copy to .env (or .env.local) and fill in. Bun loads these automatically.
DISCORD_TOKEN=
# Minutes before an event starts to post the alert (changeable at runtime via /alert)
ALERT_LEAD_TIME=5
# Folder where per-server .ics files are written
ICAL_PATH=./ical
# Event length in seconds used for the calendar end time
ICAL_EVENT_DURATION=1800
# Name of the generated .ics file
CB_FILENAME=events.ics
