{
  "name": "calendarbot",
  "version": "1.0.0",
  "description": "Discord bot that announces scheduled events, tracks RSVPs with buttons, and exports each server's events as an iCalendar (.ics) feed.",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run index.ts",
    "dev": "bun --watch index.ts",
    "build": "bun build index.ts --target=node --outfile=release/index.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "discord.js": "^14.28.1",
    "ical-generator": "^11.1.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
