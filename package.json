{
  "name": "calendarbot",
  "version": "2.0.1",
  "description": "Discord bot that announces scheduled events, tracks RSVPs with buttons, and exports each server's events as an iCalendar (.ics) feed.",
  "module": "src/main.ts",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun --watch src/main.ts | pino-pretty",
    "build": "bun build src/main.ts --target=node --outfile=release/main.mjs && rm -rf release/drizzle && cp -r drizzle release/drizzle",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/kv": "^3.4.0",
    "@nats-io/services": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "discord.js": "^14.28.1",
    "drizzle-orm": "^0.45.4",
    "ical-generator": "^11.1.3",
    "pino": "^10.4.0",
    "postgres": "^4.1.1",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19",
    "@types/bun": "^1.4.4",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "typescript": "^7.0.2"
  }
}
